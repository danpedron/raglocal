APP_ENV=production
APP_BASE_PATH=/ia
APP_VERSION=0.1.0
APP_TIMEZONE=America/Sao_Paulo
APP_SECRET=generate-a-64-character-random-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jaraguatower_ia
DB_USER=jaraguatower_ia
DB_PASS=replace-with-a-strong-password
OLLAMA_URL=http://ollama.example.invalid:11434
OLLAMA_ALLOWED_HOST=ollama.example.invalid
OLLAMA_SOURCE_IP=YOUR_VPS_PUBLIC_IP
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=
OLLAMA_TIMEOUT=120

# PDF and OCR executables. Adjust only if the server uses another installation path.
PDFTOTEXT_BIN=/usr/bin/pdftotext
PDFTOPPM_BIN=/usr/bin/pdftoppm
TESSERACT_BIN=/usr/bin/tesseract
OCR_ENABLED=1
OCR_LANG=por+eng
OCR_DPI=200

RAG_MIN_CONFIDENCE=0.75
RAG_MIN_SOURCES=1
ADMIN_EMAIL=admin@example.invalid
